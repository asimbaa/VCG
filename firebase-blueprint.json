{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the banking application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "balances": {
          "type": "object",
          "description": "Map of currency codes to balance amounts."
        }
      },
      "required": ["uid", "email", "balances"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "recipient": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] }
      },
      "required": ["userId", "date", "amount", "currency", "recipient", "type", "status"]
    },
    "SavedRecipient": {
      "title": "SavedRecipient",
      "description": "A saved transfer recipient.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "recipient": { "type": "string" },
        "region": { "type": "string" },
        "payIdType": { "type": "string" },
        "cardName": { "type": "string" },
        "cardExpiry": { "type": "string" }
      },
      "required": ["userId", "name", "type", "recipient"]
    },
    "RecurringTransfer": {
      "title": "RecurringTransfer",
      "description": "A recurring transfer setup.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "client": { "type": "string" },
        "service": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "frequency": { "type": "string" }
      },
      "required": ["userId", "client", "service", "amount", "currency", "frequency"]
    },
    "FundingSource": {
      "title": "FundingSource",
      "description": "A funding source for deposits.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "details": { "type": "string" },
        "institution": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "name", "details", "institution", "createdAt"]
    },
    "DraftTransaction": {
      "title": "DraftTransaction",
      "description": "A draft transaction saved by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "transferType": { "type": "string" },
        "amount": { "type": "string" },
        "transferCurrency": { "type": "string" },
        "recipient": { "type": "string" },
        "region": { "type": "string" },
        "cardName": { "type": "string" },
        "cardExpiry": { "type": "string" },
        "payIdType": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "updatedAt"]
    },
    "BrandAsset": {
      "title": "BrandAsset",
      "description": "An asset owned by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "owner": { "type": "string" }
      },
      "required": ["userId", "createdAt", "name", "type", "status", "owner"]
    },
    "DriverRating": {
      "title": "DriverRating",
      "description": "Post-ride rating and feedback for the driver.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "driverName": { "type": "string" },
        "rating": { "type": "number" },
        "feedback": { "type": "string" },
        "pickup": { "type": "string" },
        "destination": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "driverName", "rating", "createdAt"]
    },
    "FavoriteRoute": {
      "title": "FavoriteRoute",
      "description": "A saved address pair frequently used by the client.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "pickup": { "type": "string" },
        "destination": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "pickup", "destination", "createdAt"]
    },
    "ScheduledRide": {
      "title": "ScheduledRide",
      "description": "A scheduled future trip intent.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "pickup": { "type": "string" },
        "destination": { "type": "string" },
        "pickupCoords": { "type": "object" },
        "destCoords": { "type": "object" },
        "vehicleType": { "type": "string" },
        "scheduledTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "pickup", "destination", "vehicleType", "scheduledTime", "status", "createdAt"]
    },
    "CompletedTrip": {
      "title": "CompletedTrip",
      "description": "A completed trip record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "pickup": { "type": "string" },
        "destination": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "distance": { "type": "string" },
        "cost": { "type": "number" },
        "driverName": { "type": "string" },
        "carModel": { "type": "string" }
      },
      "required": ["userId", "pickup", "destination", "startTime", "endTime", "distance", "cost"]
    },
    "EmergencyContact": {
      "title": "EmergencyContact",
      "description": "An emergency contact SOS coordinates payload.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "driverName": { "type": "string" },
        "carModel": { "type": "string" },
        "license": { "type": "string" },
        "pickup": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "timestampMs": { "type": "number" }
      },
      "required": ["userId", "latitude", "longitude", "status", "timestamp"]
    },
    "SharedCardInvite": {
      "title": "SharedCardInvite",
      "description": "Shareable bank debit or credit card invitation with instant or physical card provisioning and automatic VIP benefit inheritance.",
      "type": "object",
      "properties": {
        "inviteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "cardId": { "type": "string", "maxLength": 64 },
        "cardName": { "type": "string", "maxLength": 120 },
        "cardCategory": { "type": "string", "enum": ["debit", "credit"] },
        "network": { "type": "string", "maxLength": 32 },
        "maskedLast4": { "type": "string", "maxLength": 8 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "recipientEmail": { "type": "string", "maxLength": 120 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "grantedLimitAUD": { "type": "number" },
        "cardMode": { "type": "string", "enum": ["virtual_instant", "virtual_and_physical"] },
        "allowPhysicalCard": { "type": "boolean" },
        "physicalDispatchStatus": { "type": "string", "enum": ["not_requested", "queued_production", "courier_dispatched"] },
        "autoShareVipBenefits": { "type": "boolean" },
        "vipBenefits": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "claimed", "revoked"] },
        "claimedByName": { "type": "string", "maxLength": 100 },
        "claimedByEmail": { "type": "string", "maxLength": 120 },
        "claimedAt": { "type": "string", "maxLength": 64 },
        "shareUrl": { "type": "string", "maxLength": 260 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteId", "ownerUid", "cardId", "cardName", "cardCategory", "status", "cardMode"]
    },
    "EmailDispatchLog": {
      "title": "EmailDispatchLog",
      "description": "Audit log record for emails dispatched via Gmail API, SMTP, or Ethereal sandbox relay.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "to": { "type": "string", "maxLength": 250 },
        "subject": { "type": "string", "maxLength": 250 },
        "channel": { "type": "string", "enum": ["gmail_api", "smtp", "ethereal_sandbox", "local_relay", "failed"] },
        "status": { "type": "string", "enum": ["delivered", "sandbox_preview", "queued_retry", "failed"] },
        "previewUrl": { "type": "string", "maxLength": 500 },
        "messageId": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "ownerUid", "to", "subject", "channel", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Operational notification and dispatch record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "maxLength": 64 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message"]
    },
    "UserEmail": {
      "title": "UserEmail",
      "description": "Inbox and sent message item stored per user.",
      "type": "object",
      "properties": {
        "to": { "type": "string", "maxLength": 250 },
        "from": { "type": "string", "maxLength": 250 },
        "subject": { "type": "string", "maxLength": 250 },
        "body": { "type": "string", "maxLength": 20000 },
        "read": { "type": "boolean" },
        "folder": { "type": "string", "maxLength": 32 },
        "date": { "type": "string", "maxLength": 64 }
      },
      "required": ["subject", "body"]
    },
    "PaymentEvent": {
      "title": "PaymentEvent",
      "description": "Audited payment event record stored under user subcollection.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "status": { "type": "string", "maxLength": 32 },
        "recipient": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "status"]
    },
    "VirtualCard": {
      "title": "VirtualCard",
      "description": "Issued bank debit or credit card record synchronized across wallets.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "cardCategory": { "type": "string", "enum": ["debit", "credit"] },
        "network": { "type": "string", "maxLength": 32 },
        "balance": { "type": "number" },
        "limit": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "name", "network"]
    },
    "AiSession": {
      "title": "AiSession",
      "description": "Persisted executive AI research and workspace conversation session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "messages": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    },
    "LuxuryConciergeBooking": {
      "title": "LuxuryConciergeBooking",
      "description": "Private aviation, superyacht, and luxury concierge booking record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "serviceType": { "type": "string", "maxLength": 120 },
        "destination": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceType", "status"]
    },
    "VoucherRecord": {
      "title": "VoucherRecord",
      "description": "Issued sovereign payment voucher or gift certificate.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "status": { "type": "string", "maxLength": 32 }
      },
      "required": ["code", "amount", "currency"]
    },
    "ScheduledOrder": {
      "title": "ScheduledOrder",
      "description": "Scheduled fulfillment order record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "merchant": { "type": "string", "maxLength": 160 },
        "total": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "merchant", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and balances."
    },
    "/users/{userId}/emails/{emailId}": {
      "schema": { "$ref": "#/entities/UserEmail" },
      "description": "User email inbox and sent messages."
    },
    "/users/{userId}/payment_events/{eventId}": {
      "schema": { "$ref": "#/entities/PaymentEvent" },
      "description": "Per-user audited payment events."
    },
    "/payment_events/{eventId}": {
      "schema": { "$ref": "#/entities/PaymentEvent" },
      "description": "Top-level audited payment events."
    },
    "/shared_card_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/SharedCardInvite" },
      "description": "Shareable bank debit and credit card invitations and claims."
    },
    "/email_dispatch_logs/{logId}": {
      "schema": { "$ref": "#/entities/EmailDispatchLog" },
      "description": "Unified email transmission audit log."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Platform notifications and dispatch alerts."
    },
    "/virtual_cards/{cardId}": {
      "schema": { "$ref": "#/entities/VirtualCard" },
      "description": "Synchronized bank debit and credit cards."
    },
    "/ai_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/AiSession" },
      "description": "Sovereign AI session transcripts per user."
    },
    "/luxury_concierge_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/LuxuryConciergeBooking" },
      "description": "Luxury concierge and aviation reservations."
    },
    "/global_vouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/VoucherRecord" },
      "description": "Global creator vouchers."
    },
    "/vouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/VoucherRecord" },
      "description": "User payment vouchers."
    },
    "/scheduled_orders/{orderId}": {
      "schema": { "$ref": "#/entities/ScheduledOrder" },
      "description": "Scheduled UberEats and merchant orders."
    },
    "/emergency_contacts/{contactId}": {
      "schema": { "$ref": "#/entities/EmergencyContact" },
      "description": "SOS emergency alerts dispatched with coordinates."
    },
    "/completed_trips/{tripId}": {
      "schema": { "$ref": "#/entities/CompletedTrip" },
      "description": "Trip history containing details of all completed rides."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transaction history."
    },
    "/saved_recipients/{recipientId}": {
      "schema": { "$ref": "#/entities/SavedRecipient" },
      "description": "Saved recipients for easy transfers."
    },
    "/recurring_transfers/{transferId}": {
      "schema": { "$ref": "#/entities/RecurringTransfer" },
      "description": "Recurring transfers."
    },
    "/funding_sources/{sourceId}": {
      "schema": { "$ref": "#/entities/FundingSource" },
      "description": "Funding sources."
    },
    "/draft_transactions/{draftId}": {
      "schema": { "$ref": "#/entities/DraftTransaction" },
      "description": "Draft transactions saved by users."
    },
    "/brand_assets/{assetId}": {
      "schema": { "$ref": "#/entities/BrandAsset" },
      "description": "Brand assets / properties owned by users."
    },
    "/driver_ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/DriverRating" },
      "description": "Post-trip feedback and rating for a vehicle partner."
    },
    "/favorite_routes/{routeId}": {
      "schema": { "$ref": "#/entities/FavoriteRoute" },
      "description": "Frequent pickup/destination route address pairs."
    },
    "/scheduled_rides/{rideId}": {
      "schema": { "$ref": "#/entities/ScheduledRide" },
      "description": "Scheduled ride reservation entries."
    },
    "/scheduled_ride/{rideId}": {
      "schema": { "$ref": "#/entities/ScheduledRide" },
      "description": "Scheduled ride reservation entries alias."
    }
  }
}
